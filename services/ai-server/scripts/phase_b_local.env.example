# 复制为 phase_b_local.env 后填写（勿提交 git）
export AI_SERVER_HMAC_SECRET=dev-ai-secret
# one-api：http://127.0.0.1:3000/v1 ；直连 DeepSeek 须带 /v1（代码会请求 …/v1/chat/completions）
export LLM_BASE_URL=https://api.deepseek.com/v1
# 直连 DeepSeek 用平台 API Key；走 one-api 时可 python3 scripts/phase_b_autofill_env.py 自动填令牌
export LLM_API_KEY=
export LLM_MODEL=deepseek-chat
export HYDRO_BASE_URL=http://127.0.0.1
export HYDRO_IMPORT_TOKEN=
export HYDRO_AUTO_SID=1
export JOB_DATA_DIR=/tmp/ai-jobs
